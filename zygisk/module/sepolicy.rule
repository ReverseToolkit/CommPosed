allow dex2oat dex2oat_exec file execute_no_trans
allow dex2oat system_linker_exec file execute_no_trans

allow shell shell dir write

type comm_file file_type
typeattribute comm_file mlstrustedobject
allow {dex2oat installd isolated_app shell} comm_file {file dir} *

allow dex2oat {unlabeled tmpfs} file *
allow zygote dex2oat unix_stream_socket *

type comm_data file_type
typeattribute comm_data mlstrustedobject
allow * comm_data {file dir} *
